 Deletable->"False",
 Evaluatable->False,
 CellChangeTimes->{{3.891096538433184*^9, 3.89109654180459*^9}, 
   3.9096694551762733`*^9, {3.911046016610118*^9, 3.91104601883628*^9}, {
   3.990264821673855*^9, 3.99026483990554*^9}, {3.990264888163412*^9, 
   3.990264888991114*^9}},ExpressionUUID->"5fb1ee3e-4b8b-7c42-a865-\
091233898fe7"],

Cell["\<\
Write the name of the corresponding data file (stored in the folder: Data \
files) as a string. Optional: If the Original images folder contains more \
than one image, add an underscore followed by an image sequence number to \
import the images in a particular order. For example, if there are two images \
in the Original images folder and their image names are imgA.tiff and \
imgB.tiff change them to imgA_1.tiff and imgB_2.tiff to ensure they are \
imported in that order.\
\>", "CodeText",
 Editable->"False",
 Deletable->"False",
 Evaluatable->False,
 CellChangeTimes->{{3.891096556058117*^9, 3.891096595886291*^9}, {
   3.892898779775897*^9, 3.8928988581972075`*^9}, {3.892898892612658*^9, 
   3.892898953649408*^9}, {3.892898986300358*^9, 3.892899305262262*^9}, {
   3.892899341502062*^9, 3.8928993630723534`*^9}, {3.90966946898428*^9, 
