Cell[TextData[{
 "The  parameter  table  contains  all  relevant  variables  for  FACT  \
analysis.  This  information  is  considered  the  analysis  metadata and its \
exported along with the fibril width statistics as a tiff file.  Each  row  \
(starting  with  the  4th)  is  where  the  parameter  values  are  manually  \
entered  and  applied  to  the  corresponding  imported  image  (in  the  \
order  they  are  imported). The  number  of  indexed rows  in  the  \
parameter  table  (starting  from  the  4th  row)  must  match  the  number  \
of  imported  images .  To  add  rows,  place  the  cursor  in  the  last  \
row  and  press  Ctrl + Enter.  Repeat  until  the  number  of  indexed  rows \
(entered manually)  equals  the  number  of  images. To delete rows, \
highlight the full rows to be deleted and press the Del button on the \
keyboard.  When  evaluated (Shift + Enter),  the  parameter  table  auto - \
fills  any  unpopulated  boxes  with  the  information  from  the  previous  \
populated  row. This auto filled parameter table is shown below in the \
display table section (",
 StyleBox["ptdisplay)",
  IgnoreSpellCheck->True],
 "."
}], "CodeText",
 Editable->False,
 Deletable->"False",
 Evaluatable->False,
 CellChangeTimes->{{3.990716143005201*^9, 3.990716193533094*^9}, {
