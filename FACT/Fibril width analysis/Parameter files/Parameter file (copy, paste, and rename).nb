   3.990716331563165*^9}, {3.990716363669681*^9, 3.990716398428224*^9}, {
   3.991146996840816*^9, 3.9911470581162415`*^9}, {3.9913163419038334`*^9, 
   3.991316349845913*^9}, {3.9914150147784367`*^9, 3.991415084893926*^9}, {
